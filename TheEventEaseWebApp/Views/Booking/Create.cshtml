@model TheEventEaseWebApp.Models.Booking

@{
    ViewData["Title"] = "Booking";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="card shadow">
                <div class="card-header bg-rosybrown text-white text-center">
                    <h2 class="mb-0">Make a Booking</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Event Dropdown -->
                        <div class="form-group mb-3">
                            <label asp-for="EventId" class="control-label">Event Name</label>
                            <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId">
                                <option value="">-- Select Event --</option>
                            </select>
                            <span asp-validation-for="EventId" class="text-danger"></span>
                        </div>

                        <!-- Venue Dropdown -->
                        <div class="form-group mb-3">
                            <label asp-for="VenueId" class="control-label">Venue Name</label>
                            <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId">
                                <option value="">-- Select Venue --</option>
                            </select>
                            <span asp-validation-for="VenueId" class="text-danger"></span>
                        </div>

                        <!-- Booking Date -->
                        <div class="form-group mb-3">
                            <label asp-for="BookingDate" class="control-label">Booking Date</label>
                            <input asp-for="BookingDate" class="form-control" type="date" />
                            <span asp-validation-for="BookingDate" class="text-danger"></span>
                        </div>

                        <!-- Create and Back Buttons -->
                        <div class="form-group mt-4 text-center">
                            <input type="submit" value="Create Booking" class="btn btn-rosybrown me-2" />
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}