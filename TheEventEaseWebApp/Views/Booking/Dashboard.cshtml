@model IEnumerable<TheEventEaseWebApp.Models.BookingViewModel>

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Dashboard";
    string currentSearchType = ViewData["SearchType"]?.ToString() ?? "";
    string venueAvailability = ViewData["VenueAvailability"]?.ToString() ?? "";
    string selectedEventTypeId = ViewData["SelectedEventTypeId"]?.ToString() ?? "";
}

<h1>Dashboard</h1>

<p>
    <a asp-action="Create" class="btn btn-rosybrown">Create New Booking</a>
</p>

<!-- Advanced Search and Filter Form -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Search & Filter Options</h5>
    </div>
    <div class="card-body">
        <form asp-action="Dashboard" method="get">
            <div class="row">
                <!-- Basic Search -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Search Type</label>
                    <div class="input-group">
                        <select name="searchType" class="form-control">
                            @if (currentSearchType == "id")
                            {
                                <option value="id" selected>Booking ID</option>
                                <option value="event">Event Name</option>
                            }
                            else if (currentSearchType == "event")
                            {
                                <option value="id">Booking ID</option>
                                <option value="event" selected>Event Name</option>
                            }
                            else
                            {
                                <option value="id">Booking ID</option>
                                <option value="event">Event Name</option>
                            }
                        </select>
                        <input type="text" name="searchQuery" value="@ViewData["SearchQuery"]" class="form-control" placeholder="Search..." />
                    </div>
                </div>

                <!-- Event Type Filter -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Event Type</label>
                    <select name="eventTypeId" class="form-control">
                        <option value="">All Event Types</option>
                        @if (ViewData["EventTypes"] is SelectList eventTypes)
                        {
                            @foreach (SelectListItem item in eventTypes)
                            {
                                @if (item.Value == selectedEventTypeId)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="row">
                <!-- Date Range Filter -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control" />
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control" />
                </div>

                <!-- Venue Availability Filter -->
                <div class="col-md-3 mb-3">
                    <label class="form-label">Venue Availability</label>
                    <select name="venueAvailability" class="form-control">
                        @if (string.IsNullOrEmpty(venueAvailability))
                        {
                            <option value="" selected>All Venues</option>
                            <option value="true">Available Only</option>
                            <option value="false">Unavailable Only</option>
                        }
                        else if (venueAvailability.ToLower() == "true")
                        {
                            <option value="">All Venues</option>
                            <option value="true" selected>Available Only</option>
                            <option value="false">Unavailable Only</option>
                        }
                        else if (venueAvailability.ToLower() == "false")
                        {
                            <option value="">All Venues</option>
                            <option value="true">Available Only</option>
                            <option value="false" selected>Unavailable Only</option>
                        }
                        else
                        {
                            <option value="" selected>All Venues</option>
                            <option value="true">Available Only</option>
                            <option value="false">Unavailable Only</option>
                        }
                    </select>
                </div>

                <!-- Filter Buttons -->
                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <div class="btn-group w-100">
                        <button type="submit" class="btn btn-rosybrown">Apply Filters</button>
                        <a asp-action="Dashboard" class="btn btn-secondary">Clear All</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results Section -->
<div class="row">
    @if (Model != null)
    {
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card border-rosybrown">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Booking #@item.BookingId</h5>
                            @if (!string.IsNullOrEmpty(item.EventTypeName))
                            {
                                <span class="badge bg-info text-white">@item.EventTypeName</span>
                            }
                            <span class="badge @(item.VenueAvailability ? "bg-success" : "bg-danger") text-white">
                                @(item.VenueAvailability ? "Available" : "Unavailable")
                            </span>
                        </div>
                        <div>
                            <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                @if (!string.IsNullOrEmpty(item.EventImageUrl))
                                {
                                    <img src="@item.EventImageUrl" class="img-fluid rounded" alt="@item.EventName" />
                                }
                                else
                                {
                                    <div class="bg-light text-center p-4 rounded">
                                        <i class="bi bi-calendar-event" style="font-size: 3rem;"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <h5 class="card-title">@item.EventName</h5>
                                <h6 class="text-muted">@item.VenueName</h6>

                                <div class="mt-3">
                                    <p><strong>Booking Date:</strong> @(item.BookingDate?.ToString("MMM dd, yyyy") ?? "Not set")</p>
                                    <p><strong>Event Date:</strong> @(item.EventDate?.ToString("MMM dd, yyyy") ?? "Not set")</p>
                                    <p><strong>Location:</strong> @item.Location</p>
                                    <p><strong>Venue Capacity:</strong> @item.Capacity</p>
                                    @if (!string.IsNullOrEmpty(item.EventTypeName))
                                    {
                                        <p><strong>Event Type:</strong> @item.EventTypeName</p>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(item.EventDescription))
                                {
                                    <div class="mt-3">
                                        <p class="card-text text-truncate">@item.EventDescription</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <h5>No bookings found</h5>
        <p>No bookings match your current filter criteria. Try adjusting your filters or <a asp-action="Create">create a new booking</a>.</p>
    </div>
}