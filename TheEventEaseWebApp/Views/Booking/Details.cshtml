@model TheEventEaseWebApp.Models.Booking

@{
    ViewData["Title"] = "Details";
}

<h1>Booking Details</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.BookingDate)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.BookingDate)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Event)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Event.EventName)
        @if (Model.Event?.EventType != null)
        {
            <span class="badge bg-info text-white ms-2">@Model.Event.EventType.Name</span>
        }
    </dd>
    <dt class="col-sm-2">
        Event Date
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Event.EventDate)
    </dd>
    <dt class="col-sm-2">
        Event Description
    </dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Event?.Description))
        {
            @Html.DisplayFor(model => model.Event.Description)
        }
        else
        {
            <span class="text-muted">No description available</span>
        }
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Venue)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Venue.VenueName)
        @if (Model.Venue != null)
        {
            <span class="badge @(Model.Venue.Availability ? "bg-success" : "bg-danger") text-white ms-2">
                @(Model.Venue.Availability ? "Available" : "Unavailable")
            </span>
        }
    </dd>
    <dt class="col-sm-2">
        Venue Location
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Venue.Location)
    </dd>
    <dt class="col-sm-2">
        Venue Capacity
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Venue.Capacity)
    </dd>
    <!-- Event Image -->
    <dt class="col-sm-2">
        Event Image
    </dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Event?.ImageUrl))
        {
            <img src="@Model.Event.ImageUrl" alt="Event Image" class="img-thumbnail" style="width:150px; height:100px;">
        }
        else
        {
            <span class="text-muted">No Event Image Available</span>
        }
    </dd>
    <!-- Venue Image -->
    <dt class="col-sm-2">
        Venue Image
    </dt>
    <dd class="col-sm-10">
        @if (!string.IsNullOrEmpty(Model.Venue?.ImageUrl))
        {
            <img src="@Model.Venue.ImageUrl" alt="Venue Image" class="img-thumbnail" style="width:150px; height:100px;">
        }
        else
        {
            <span class="text-muted">No Venue Image Available</span>
        }
    </dd>
</dl>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.BookingId" class="btn btn-rosybrown me-2">Edit</a>
    <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>