@model TheEventEaseWebApp.Models.Venue

@{
    ViewData["Title"] = "Venue";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="card shadow">
                <div class="card-header bg-rosybrown text-white text-center">
                    <h2 class="mb-0">Create Venue</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Venue Name Field -->
                        <div class="form-group mb-3">
                            <label asp-for="VenueName" class="control-label">Venue Name</label>
                            <input asp-for="VenueName" class="form-control" />
                            <span asp-validation-for="VenueName" class="text-danger"></span>
                        </div>

                        <!-- Location Field -->
                        <div class="form-group mb-3">
                            <label asp-for="Location" class="control-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <!-- Capacity Field -->
                        <div class="form-group mb-3">
                            <label asp-for="Capacity" class="control-label"></label>
                            <input asp-for="Capacity" class="form-control" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>

                        <!-- Availability Field -->
                        <div class="form-group mb-3">
                            <div class="form-check">
                                <input asp-for="Availability" class="form-check-input" type="checkbox" />
                                <label asp-for="Availability" class="form-check-label">Available for booking</label>
                            </div>
                            <span asp-validation-for="Availability" class="text-danger"></span>
                        </div>

                        <!-- Image Upload Field -->
                        <div class="form-group mb-3">
                            <label for="imageFile" class="control-label">Venue Image</label>
                            <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <!-- Create Button and Back Button -->
                        <div class="form-group mt-4 text-center">
                            <input type="submit" value="Create Venue" class="btn btn-rosybrown me-2" />
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}